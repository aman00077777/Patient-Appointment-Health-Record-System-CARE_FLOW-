# Flask Configuration
FLASK_APP=run.py
FLASK_DEBUG=True
SECRET_KEY=replace_with_a_long_random_string_here

# Database Configuration
# Fallbacks to SQLite if DATABASE_URL is not set
# For production (PostgreSQL): postgresql://username:password@hostname:port/database
DATABASE_URL=sqlite:///healthcare.db

# Email Configuration (Gmail SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER=your-gmail@gmail.com
